# ------------------------------------------------------------------------------
# CHATWOOT PRODUCTION ENVIRONMENT CONFIGURATION
# Dominio: https://chatwood.digianaapp.com.br
# ------------------------------------------------------------------------------

# === CHAVE CRIPTOGRAFICA PRINCIPAL (OBRIGATORIO) ===
# Gere uma nova chave alfanumerica segura com: openssl rand -hex 64
# ou via docker: docker compose -f docker-compose.production.yaml run --rm rails bundle exec rake secret
SECRET_KEY_BASE=COLOQUE_AQUI_SUA_SECRET_KEY_BASE_GERADA_COM_OPENSSL_RAND_HEX_64

# === AMBIENTE E DOMINIO ===
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
FRONTEND_URL=https://chatwood.digianaapp.com.br
FORCE_SSL=true

# Ativa / Desativa criacao publica de novas contas via interface
ENABLE_ACCOUNT_SIGNUP=false

# Idioma padrao (pt_BR, en, etc.)
DEFAULT_LOCALE=pt_BR

# === BANCO DE DADOS (POSTGRESQL) ===
# Comunicacao direta pela rede interna chatwoot_net com o container chatwoot_db
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot_production
POSTGRES_DB=chatwoot_production
POSTGRES_USERNAME=chatwoot
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=DEFINA_UMA_SENHA_SEGURA_POSTGRES
POSTGRES_STATEMENT_TIMEOUT=14s

# === CACHE E FILAS (REDIS) ===
# Comunicacao direta pela rede interna chatwoot_net com o container chatwoot_redis
REDIS_URL=redis://default:DEFINA_UMA_SENHA_SEGURA_REDIS@redis:6379
REDIS_PASSWORD=DEFINA_UMA_SENHA_SEGURA_REDIS

# === ARMAZENAMENTO DE ARQUIVOS (ACTIVE STORAGE) ===
ACTIVE_STORAGE_SERVICE=local

# === LOGS ===
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# === EMAIL / SMTP (Configure com seu servidor SMTP) ===
MAILER_SENDER_EMAIL=Chatwoot <atendimento@chatwood.digianaapp.com.br>
SMTP_DOMAIN=chatwood.digianaapp.com.br
SMTP_ADDRESS=smtp.seuservidor.com.br
SMTP_PORT=587
SMTP_USERNAME=seu_usuario_smtp
SMTP_PASSWORD=sua_senha_smtp
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# === PERFORMANCE E WORKERS ===
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=10
